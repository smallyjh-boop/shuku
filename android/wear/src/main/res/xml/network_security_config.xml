<?xml version="1.0" encoding="utf-8"?>
<!-- 书库在家里用 http 访问（内网），出门用 Tailscale；允许 http，也信任用户自己装的证书 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>

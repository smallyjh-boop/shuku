<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 在手表上听书：后台播放、熄屏时接着合成下一句、播放控制的通知 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <!-- 手表自带语音引擎（Android 11 起需要声明） -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- 去连蓝牙耳机：系统的输出设备面板、蓝牙设置 -->
        <intent>
            <action android:name="com.android.settings.panel.action.MEDIA_OUTPUT" />
        </intent>
        <intent>
            <action android:name="android.settings.BLUETOOTH_SETTINGS" />
        </intent>
    </queries>

    <application
        android:name=".WearApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShukuWatch"
        android:usesCleartextTraffic="true">

        <!-- 不装手机 App 也能用（手动输入地址和配对码） -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ReadActivity" android:exported="false" />
        <activity
            android:name=".ListenActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity android:name=".TocActivity" android:exported="false" />
        <activity android:name=".BooksActivity" android:exported="false" />
        <activity
            android:name=".ConnectActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 在手表上听书 -->
        <service
            android:name=".ListenService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 手机发来的消息：连接信息、听书状态 -->
        <service
            android:name=".WatchListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:host="*" android:pathPrefix="/shuku" android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>

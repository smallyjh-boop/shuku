<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".WearApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShukuWatch"
        android:usesCleartextTraffic="true">

        <!-- 不装手机 App 也能用（手动输入地址和配对码） -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ReadActivity" android:exported="false" />
        <activity android:name=".TocActivity" android:exported="false" />
        <activity android:name=".BooksActivity" android:exported="false" />
        <activity
            android:name=".ConnectActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 手机发来的消息：连接信息、听书状态 -->
        <service
            android:name=".WatchListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:host="*" android:pathPrefix="/shuku" android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
